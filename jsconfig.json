{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*": ["manager/*"],
      "@/components/*": ["manager/components/*"],
      "@/assets/*": ["manager/assets/*"],
      "@/hooks/*": ["manager/hooks/*"],
      "@/utils/*": ["manager/utils/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}